# Copy this to .env and fill in your keys:  cp .env.example .env

# Groq (final AI review via openai/gpt-oss-120b)
# GROQ_API_KEY=gsk_your_key_here
# ATS_GROQ_MODEL=openai/gpt-oss-120b

# Anthropic (optional "Add Claude scoring" per-job toggle)
# ANTHROPIC_API_KEY=
# ATS_LLM_MODEL=claude-haiku-4-5-20251001

# App
# SECRET_KEY=change-me-to-a-random-string
# COMPANY_NAME=Cloud Reboot
# DATABASE_URL=sqlite:///./ats.db
# UPLOAD_DIR=uploads

# Bootstrap a recruiter login on startup (optional)
# ADMIN_EMAIL=you@yourcompany.com
# ADMIN_PASSWORD=at-least-8-chars
